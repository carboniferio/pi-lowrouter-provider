{
  "name": "@lowrouter/pi-provider",
  "version": "0.1.1",
  "description": "LowRouter provider for Pi: EU-run, carbon-aware model router behind one OpenAI-compatible API.",
  "license": "Apache-2.0",
  "author": "carboniferio",
  "type": "module",
  "homepage": "https://lowrouter.ai/docs/integrations/pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carboniferio/pi-lowrouter-provider.git"
  },
  "bugs": {
    "url": "https://github.com/carboniferio/pi-lowrouter-provider/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-provider",
    "lowrouter",
    "llm",
    "provider"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run test/models.test.ts test/index.test.ts",
    "test:live": "vitest run test/lowrouter.live.test.ts",
    "gen:catalog": "npm run build && node scripts/gen-catalog.mjs && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
